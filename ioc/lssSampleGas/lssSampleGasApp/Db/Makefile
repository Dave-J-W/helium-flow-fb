TOP=../..
include $(TOP)/configure/CONFIG

# sampleGas.db and the two autosave request files are generated by ioc/tools/gen_db.py from
# ioc/tools/sg_pvs.py (spec docs/ioc/15LSS_sample_gas_IOC_spec.md §7, §9) and committed; the
# production build needs no Python. Regenerate with:
#   python ioc/tools/gen_db.py          (write)
#   python ioc/tools/gen_db.py --check  (verify committed files are up to date)
#
# The .req files are installed the same way as the .db file: the generic $(INSTALL_DB)/% rule in
# EPICS base's RULES.Db installs any file added to DB, and autosave's set_requestfile_path finds
# its .req files under the IOC's db/ install directory by convention.
DB += sampleGas.db
DB += sampleGas_settings.req
DB += sampleGas_helium.req

include $(TOP)/configure/RULES
