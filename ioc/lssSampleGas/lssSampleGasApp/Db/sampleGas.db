record(calc, "$(P)Sts:TickAge") {
    field(DESC, "Seconds since the last tick")
    field(SCAN, "1 second")
    field(INPA, "$(P)Sts:Heartbeat NPP")
    field(INPB, "$(P)Sts:HbLast NPP")
    field(INPC, "$(P)Sts:TickAge NPP")
    field(CALC, "A#B?0:C+1")
    field(EGU, "s")
    field(PREC, "0")
    field(HIHI, "10")
    field(HHSV, "MAJOR")
    field(HOPR, "60")
    field(FLNK, "$(P)Sts:HbLast")
}

record(calc, "$(P)Sts:HbLast") {
    field(DESC, "Heartbeat at the last TickAge scan")
