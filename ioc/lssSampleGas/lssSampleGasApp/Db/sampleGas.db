    field(EGU, "L/day")
    field(PREC, "2")
}

record(ai, "$(P)He:Rep:Dispensed") {
    field(PREC, "2")
}

record(ai, "$(P)He:Rep:InRuns") {
    field(PREC, "2")
}

record(ai, "$(P)He:Rep:Cylinders") {
    field(PREC, "2")
}

record(ai, "$(P)He:Rep:CylEquiv") {
    field(PREC, "2")
}

record(ai, "$(P)He:Rep:WinStart") {
    field(PREC, "2")
}

record(ai, "$(P)He:Rep:WinEnd") {
    field(PREC, "2")
}

record(waveform, "$(P)He:Rep:RunStart") {
    field(FTVL, "DOUBLE")
    field(NELM, "100")
}

record(waveform, "$(P)He:Rep:RunEnd") {
    field(FTVL, "DOUBLE")
    field(NELM, "100")
}

record(waveform, "$(P)He:Rep:RunPurges") {
    field(FTVL, "LONG")
    field(NELM, "100")
}

record(waveform, "$(P)He:Rep:RunL") {
    field(FTVL, "DOUBLE")
    field(NELM, "100")
}

record(waveform, "$(P)He:Rep:RunCyl") {
    field(FTVL, "LONG")
    field(NELM, "100")
}

record(waveform, "$(P)He:Rep:RunFinished") {
    field(FTVL, "LONG")
    field(NELM, "100")
}

record(longin, "$(P)He:Rep:RunN") {

}

record(waveform, "$(P)He:Rep:Text") {
    field(DESC, "Human-readable usage report")
    field(FTVL, "CHAR")
    field(NELM, "8192")
}

record(epid, "$(P)PID") {
    field(DESC, "PID step; VAL/KP/KI/DRVL/DRVH/ODEL/FBON ")
    field(SCAN, "Passive")
    field(INP, "$(P)PID:CVAL NPP")
    field(OUTL, "$(P)PID:Out NPP")
    field(KD, "0")
    field(FMOD, "PID")
    field(PREC, "4")
    field(EGU, "SLPM")
}

record(ai, "$(P)PID:CVAL") {
    field(DESC, "Mean of the last avgN valid O2 samples")
    field(EGU, "%")
    field(PREC, "3")
}

record(ao, "$(P)PID:Out") {
    field(DESC, "epid's output (soft)")
    field(EGU, "SLPM")
    field(PREC, "3")
}

record(stringout, "$(P)Cfg:MFC") {
    field(VAL, "$(MFC)")
    field(PINI, "YES")
}

record(stringout, "$(P)Cfg:O2") {
    field(VAL, "$(O2)")
    field(PINI, "YES")
}

record(stringout, "$(P)Cfg:CYL") {
    field(VAL, "$(CYL)")
    field(PINI, "YES")
}

record(stringout, "$(P)Cfg:STN") {
    field(VAL, "$(STN)")
    field(PINI, "YES")
}

record(stringin, "$(P)Cfg:Default:MFC") {
    field(VAL, "$(MFC)")
    field(PINI, "YES")
}

record(stringin, "$(P)Cfg:Default:O2") {
    field(VAL, "$(O2)")
    field(PINI, "YES")
}

record(stringin, "$(P)Cfg:Default:CYL") {
    field(VAL, "$(CYL)")
    field(PINI, "YES")
}

record(stringin, "$(P)Cfg:Default:STN") {
    field(VAL, "$(STN)")
    field(PINI, "YES")
}

record(stringin, "$(P)Cfg:Active:MFC") {

}

record(stringin, "$(P)Cfg:Active:O2") {

}

record(stringin, "$(P)Cfg:Active:CYL") {

}

record(stringin, "$(P)Cfg:Active:STN") {

}

record(bo, "$(P)Cfg:Apply") {
    field(DESC, "Apply the edited names")
}

record(bo, "$(P)Cfg:RestoreDefaults") {
    field(DESC, "Copy the macro defaults into the fields")
}

record(bi, "$(P)Cfg:Pending") {
    field(ZNAM, "applied")
    field(ONAM, "pending")
}

record(bi, "$(P)Cfg:Conn:MFC") {
    field(ZNAM, "Disconnected")
    field(ONAM, "Connected")
}

record(bi, "$(P)Cfg:Conn:O2") {
    field(ZNAM, "Disconnected")
    field(ONAM, "Connected")
}

record(bi, "$(P)Cfg:Conn:CYL") {
    field(ZNAM, "Disconnected")
    field(ONAM, "Connected")
}

record(lsi, "$(P)Cfg:Status") {
    field(DESC, "Last apply result")
    field(SIZV, "256")
}

