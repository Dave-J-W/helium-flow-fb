# RELEASE - Location of external support modules
#
# IF YOU MAKE ANY CHANGES to this file you must subsequently do a "make rebuild" in this
# application's top level directory.
#
# Laid out like the other tops in the ChemMatCARS synApps support tree (ChemMat/configure/RELEASE,
# LabJack-R3-0/configure/RELEASE): the paths below ARE the production host's (spec §11.2), so a
# build on that host needs no RELEASE.local. The user directed that the real paths be published
# (build paths are routinely public in EPICS RELEASE files). Elsewhere, override them in
# configure/RELEASE.local (gitignored), which is read last:
#   bench (MinGW):  SUPPORT=/home/support and EPICS_BASE=/home/base-7.0.8.1, plus every module
#                   path, because the bench uses unversioned directory names (RELEASE.local.example)
#   WSL check:      written by ioc/tools/linux_build_check.sh
# Variables may be used before their values are set; the -include lines at the end are read last.
#
# This file should ONLY define paths to other support modules, or include statements that pull
# in similar RELEASE files. Build settings that are NOT module paths belong in CONFIG_SITE.

TEMPLATE_TOP=$(EPICS_BASE)/templates/makeBaseApp/top

# The production synApps support directory (as in its own configure/RELEASE)
SUPPORT=/home/chem_epics/chemmatCARS/synApps/support
-include $(TOP)/../configure/SUPPORT.$(EPICS_HOST_ARCH)

# External modules required for building this IOC
SNCSEQ=$(SUPPORT)/sequencer-mirror-R2-2-9
ASYN=$(SUPPORT)/asyn-R4-44-2
CALC=$(SUPPORT)/calc-R3-7-5
SSCAN=$(SUPPORT)/sscan-R2-11-6
STD=$(SUPPORT)/std-R3-6-4
AUTOSAVE=$(SUPPORT)/autosave-R5-11

# EPICS_BASE usually appears last so other apps can override stuff:
EPICS_BASE=/usr/local/epics/base

# These lines allow developers to override these RELEASE settings without having to modify
# this file directly.
-include $(TOP)/../RELEASE.local
-include $(TOP)/../RELEASE.$(EPICS_HOST_ARCH).local
-include $(TOP)/configure/RELEASE.local
