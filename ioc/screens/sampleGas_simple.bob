    </foreground_color>
    <tooltip>resume feedback from the current flow, without a purge</tooltip>
    <enabled>false</enabled>
    <rules>
      <rule name="resume_enable" prop_id="enabled" out_exp="false">
        <exp bool_exp="(pv0 == 5 &amp;&amp; pv1 == 1) || (pv0 == 0 &amp;&amp; pv1 == 1 &amp;&amp; pv2 &lt; pv3)">
          <value>true</value>
        </exp>
        <pv_name>$(P)Sts:State</pv_name>
        <pv_name>$(P)Sts:O2Valid</pv_name>
        <pv_name>$(P)Sts:O2</pv_name>
        <pv_name>$(P)Par:lidLevel</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="label" version="2.0.0">
    <name>mode_lbl</name>
    <text>Mode</text>
    <x>10</x>
    <y>332</y>
    <width>40</width>
    <height>24</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <foreground_color>
      <color red="85" green="85" blue="85" />
    </foreground_color>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>mode</name>
    <pv_name>$(P)Mode</pv_name>
    <x>50</x>
    <y>332</y>
    <width>220</width>
    <height>24</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <foreground_color>
      <color red="85" green="85" blue="85" />
    </foreground_color>
    <transparent>true</transparent>
    <show_units>false</show_units>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>btn_full</name>
    <actions>
      <action type="open_display">
        <file>sampleGas_main.bob</file>
        <macros>
          <P>$(P)</P>
        </macros>
        <target>tab</target>
        <description>Full panel…</description>
      </action>
    </actions>
    <text>Full panel…</text>
    <x>320</x>
    <y>331</y>
    <width>110</width>
    <height>26</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <background_color>
      <color red="255" green="255" blue="255" />
    </background_color>
    <foreground_color>
      <color red="34" green="34" blue="34" />
    </foreground_color>
  </widget>
</display>
