  <widget type="action_button" version="3.0.0">
    <name>btn_shadow</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)Par:writeEnable</pv_name>
        <value>0</value>
        <description>Shadow (off)</description>
      </action>
    </actions>
    <text>Shadow (off)</text>
    <x>172</x>
    <y>44</y>
    <width>112</width>
    <height>26</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <background_color>
      <color red="255" green="255" blue="255" />
    </background_color>
    <foreground_color>
      <color red="34" green="34" blue="34" />
    </foreground_color>
    <enabled>false</enabled>
    <show_confirm_dialog>true</show_confirm_dialog>
    <confirm_message>Switch to shadow mode? The controller keeps running but stops writing; the Alicat stays at its current flow until someone changes it.</confirm_message>
    <rules>
      <rule name="confirm_text" prop_id="confirm_message" out_exp="true">
        <exp bool_exp="true">
          <expression>"Switch to shadow mode? The controller keeps running but stops writing; the Alicat stays at its current flow (" + "%.2f" % pv1 + " SLPM) until someone changes it."</expression>
        </exp>
        <pv_name>$(P)Cfg:Active:MFC</pv_name>
        <pv_name>$(P)Sts:SetpointRBV</pv_name>
      </rule>
      <rule name="enable_if_live" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1">
          <value>true</value>
        </exp>
        <pv_name>$(P)Par:writeEnable</pv_name>
      </rule>
      <rule name="highlight" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>
            <color red="250" green="199" blue="117" />
          </value>
        </exp>
        <pv_name>$(P)Par:writeEnable</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>btn_live</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)Par:writeEnable</pv_name>
        <value>1</value>
        <description>Live (on)</description>
      </action>
    </actions>
    <text>Live (on)</text>
    <x>290</x>
    <y>44</y>
    <width>100</width>
    <height>26</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <background_color>
      <color red="255" green="255" blue="255" />
    </background_color>
    <foreground_color>
      <color red="34" green="34" blue="34" />
    </foreground_color>
    <enabled>false</enabled>
    <show_confirm_dialog>true</show_confirm_dialog>
    <confirm_message>Enable writes? The Alicat stays at its current flow. The controller goes to IDLE and changes nothing until you press Purge, Flow Zero or Resume Flow.</confirm_message>
    <rules>
      <rule name="confirm_text" prop_id="confirm_message" out_exp="true">
        <exp bool_exp="true">
          <expression>"Enable writes? The Alicat (" + pvStr0 + ") stays at its current flow (" + "%.2f" % pv1 + " SLPM). The controller goes to IDLE and changes nothing until you press Purge, Flow Zero or Resume Flow."</expression>
        </exp>
        <pv_name>$(P)Cfg:Active:MFC</pv_name>
        <pv_name>$(P)Sts:SetpointRBV</pv_name>
      </rule>
      <rule name="enable_if_shadow" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>true</value>
        </exp>
        <pv_name>$(P)Par:writeEnable</pv_name>
      </rule>
      <rule name="highlight" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 1">
          <value>
            <color red="192" green="221" blue="151" />
          </value>
        </exp>
        <pv_name>$(P)Par:writeEnable</pv_name>
      </rule>
    </rules>
  </widget>
