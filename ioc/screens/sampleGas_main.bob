    <transparent>false</transparent>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <rules>
      <rule name="state_colour" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>
            <color red="138" green="138" blue="138" />
          </value>
        </exp>
        <exp bool_exp="pv0 == 1">
          <value>
            <color red="142" green="124" blue="195" />
          </value>
        </exp>
        <exp bool_exp="pv0 == 2">
          <value>
            <color red="47" green="111" blue="191" />
          </value>
        </exp>
        <exp bool_exp="pv0 == 3">
          <value>
            <color red="79" green="154" blue="168" />
          </value>
        </exp>
        <exp bool_exp="pv0 == 4">
          <value>
            <color red="76" green="154" blue="42" />
          </value>
        </exp>
        <exp bool_exp="pv0 == 5">
          <value>
            <color red="224" green="138" blue="30" />
          </value>
        </exp>
        <exp bool_exp="pv0 == 6">
          <value>
            <color red="85" green="85" blue="85" />
          </value>
        </exp>
        <exp bool_exp="pv0 == 7">
          <value>
            <color red="192" green="0" blue="0" />
          </value>
        </exp>
        <pv_name>$(P)Sts:State</pv_name>
      </rule>
    </rules>
  </widget>
