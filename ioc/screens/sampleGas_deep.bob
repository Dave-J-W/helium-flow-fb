  <widget type="action_button" version="3.0.0">
    <name>btn_apply</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(P)Cfg:Apply</pv_name>
        <value>1</value>
        <description>Apply PV names</description>
      </action>
    </actions>
    <text>Apply PV names</text>
    <x>10</x>
    <y>188</y>
    <width>140</width>
    <height>26</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <background_color>
      <color red="255" green="255" blue="255" />
    </background_color>
    <foreground_color>
      <color red="34" green="34" blue="34" />
    </foreground_color>
    <tooltip>Enabled only in IDLE (the controller does not own the flow)</tooltip>
    <enabled>false</enabled>
    <show_confirm_dialog>true</show_confirm_dialog>
    <confirm_message>Apply the edited PV names? If the Alicat prefix (Cfg:MFC) changed, the helium totalizer is re-baselined (press New He cylinder if the cylinder differs); in the PC trial, writes are also disabled until you re-enable them on the Admin screen.</confirm_message>
    <rules>
      <rule name="idle_only" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>true</value>
        </exp>
        <pv_name>$(P)Sts:State</pv_name>
      </rule>
    </rules>
  </widget>
